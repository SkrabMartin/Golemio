# Copy to /etc/headway/collector.env, fill in, then: chmod 600 /etc/headway/collector.env
# Never commit the filled-in file.

# Golemio API key from https://api.golemio.cz/api-keys (required).
GOLEMIO_TOKEN=

# Where raw snapshots and the daily manifests are written.
HEADWAY_PATHS__RAW_DIR=/srv/headway/raw
HEADWAY_PATHS__MANIFEST_DIR=/srv/headway/raw/manifest
# Daily static GTFS snapshots and their registry (used by headway-gtfs.service).
HEADWAY_PATHS__GTFS_DIR=/srv/headway/gtfs

# Optional: ntfy topic URL for heartbeats and alerts, e.g. https://ntfy.sh/<long-random-name>.
# Anyone who knows a public topic name can read it, so use a long random name.
HEADWAY_COLLECT__NTFY_URL=
