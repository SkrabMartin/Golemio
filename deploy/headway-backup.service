[Unit]
Description=Headway nightly backup and disk-usage check
Documentation=https://github.com/SkrabMartin/headway/blob/main/deploy/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=headway
Group=headway
EnvironmentFile=/etc/headway/backup.env
ExecStart=/opt/headway/deploy/backup.sh
Nice=10
IOSchedulingClass=idle
