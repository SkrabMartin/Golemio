# Copy to /etc/headway/backup.env, fill in, then: chmod 600 /etc/headway/backup.env

# rsync destination: a local mount or an SSH target the headway user can reach with a key.
#   BACKUP_DEST=/mnt/backup/headway
#   BACKUP_DEST=backup@nas.local:/volume1/headway
BACKUP_DEST=

# Data directory on this machine (contains raw/ and raw/manifest/).
DATA_DIR=/srv/headway

# Alert when the data filesystem is fuller than this (percent).
DISK_ALERT_PCT=85

# Optional ntfy topic URL for failure and disk-usage alerts.
NTFY_URL=
